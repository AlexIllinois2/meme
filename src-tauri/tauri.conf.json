{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meme",
  "version": "0.1.0",
  "identifier": "com.v.meme",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "咪萌",
        "width": 800,
        "height": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOWNLOADS/**", "$DOCUMENT/**", "**"]
      }
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "dialog": null
  },
  "bundle": {
    "active": true,
    "targets": [ "rpm" ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
