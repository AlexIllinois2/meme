{
  "name": "meme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:store": "vite --mode store",
    "build": "vue-tsc --noEmit && vite build",
    "build:oss": "vue-tsc --noEmit && vite build --mode oss",
    "build:store": "vue-tsc --noEmit && vite build --mode store",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:store": "tauri build --config src-tauri/tauri.store.conf.json",
    "android:build": "tauri android build",
    "android:build:store": "tauri android build --config src-tauri/tauri.store.conf.json"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@varlet/ui": "^3.14.2",
    "tauri-plugin-share": "^2.0.4",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vconsole": "^3.15.1",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
